*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
.env
.env.*
!.env.example

# --- Next.js, Node & Frontend ---
node_modules/
.next/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# --- Documentation & MkDocs Build Artifacts ---
site/
.mkdocs/

# --- Database & Caching Storage Dumps ---
*.db
*.sqlite
*.sqlite3
dump.rdb
*.parquet
/minio_storage/
/postgres_data/

