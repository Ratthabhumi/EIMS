# EIMS Environment Secrets Template (Core Law 5 Compliance)
# ------------------------------------------------------------------
# Copy to `.env` in the repository root and replace all values before
# starting in any environment other than local development.
# The system will refuse to boot outside the `development` tier
# when any of these remain on the default values.
# ------------------------------------------------------------------

# Environment tier
EIMS_ENVIRONMENT=development

# PostgreSQL relational persistence
EIMS_DB_USER=eims_user
EIMS_DB_PASSWORD=eims_secret_password
EIMS_DB_HOST=127.0.0.1
EIMS_DB_PORT=5432
EIMS_DB_NAME=eims_registry

# Redis telemetry broker & volatile cache tier
# Use the IPv4 literal for a local/Docker-published Redis: on Windows "localhost" resolves to ::1 first while Docker
# publishes IPv4 only, which stalls every Redis call (~26 s) and fails the health ping. Use the service name inside Compose.
EIMS_REDIS_HOST=127.0.0.1
EIMS_REDIS_PORT=6379

# Cryptographic secret management
EIMS_JWT_SECRET_KEY=replace_with_64_char_hex_secret_in_production
EIMS_JWT_ALGORITHM=HS256
EIMS_ACCESS_TOKEN_EXPIRES_MINUTES=60
EIMS_ADMIN_TOKEN=replace_with_secure_admin_token_in_production
EIMS_ADMIN_PASSWORD=replace_with_secure_admin_password_in_production
EIMS_AUTH_MODE=demo

# MinIO object storage (S3-compatible)
EIMS_MINIO_ENDPOINT=127.0.0.1:9000
EIMS_MINIO_ACCESS_KEY=eims_minio_admin
EIMS_MINIO_SECRET_KEY=eims_minio_secret
EIMS_MINIO_BUCKET_NAME=eims-ocr-manifests
EIMS_MINIO_SECURE=false

# --- Portal System & Infrastructure console URLs (public only) ------------
# These are browser-visible destinations for the existing System & Infra menu.
# NEVER put passwords, ADMIN_TOKEN, MinIO keys, or DB credentials in NEXT_PUBLIC_*.
# Defaults match docker-compose.yml local bindings when unset.
# NEXT_PUBLIC_EIMS_API_URL=http://localhost:8000
# NEXT_PUBLIC_EIMS_API_DOCS_URL=http://localhost:8000/api/docs
# NEXT_PUBLIC_EIMS_GRAFANA_URL=http://localhost:3000
# NEXT_PUBLIC_EIMS_MINIO_CONSOLE_URL=http://localhost:9001
# NEXT_PUBLIC_EIMS_PROMETHEUS_URL=http://localhost:9090
# Server-only backend override for BFF / infra-status (not embedded in bundles):
# EIMS_BACKEND_URL=http://localhost:8000

# --- Runtime DB identity (R-1) --------------------------------------------
# The live connection must report exactly "<database>|<role>".
# EIMS_DB_IDENTITY_REQUIRED=1 makes a missing/malformed value fail startup, so
# a mis-targeted process never serves traffic. The compose stack below is
# development-only and uses the owner role; production must use a separate
# least-privilege runtime role (deploy/sql/provision_runtime_roles.sql).
EIMS_DB_IDENTITY=eims_registry|eims_user
EIMS_DB_IDENTITY_REQUIRED=1
