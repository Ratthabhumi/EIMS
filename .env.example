# EIMS Environment Secrets Template (Core Law 5 Compliance)
# ------------------------------------------------------------------
# Copy to `.env` in the repository root and replace all values before
# starting in any environment other than local development.
# The system will refuse to boot outside the `development` tier
# when any of these remain on the default values.
# ------------------------------------------------------------------

# Environment tier
EIMS_ENVIRONMENT=development

# PostgreSQL relational persistence
EIMS_DB_USER=eims_user
EIMS_DB_PASSWORD=eims_secret_password
EIMS_DB_HOST=localhost
EIMS_DB_PORT=5432
EIMS_DB_NAME=eims_registry

# Redis telemetry broker & volatile cache tier
EIMS_REDIS_HOST=localhost
EIMS_REDIS_PORT=6379

# Cryptographic secret management
EIMS_JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
EIMS_JWT_ALGORITHM=HS256
EIMS_ACCESS_TOKEN_EXPIRES_MINUTES=60
EIMS_ADMIN_TOKEN=EIMS-ADMIN-TOKEN
EIMS_ADMIN_PASSWORD=P@ssw0rd

# MinIO object storage (S3-compatible)
EIMS_MINIO_ENDPOINT=localhost:9000
EIMS_MINIO_ACCESS_KEY=eims_minio_admin
EIMS_MINIO_SECRET_KEY=eims_minio_secret
EIMS_MINIO_BUCKET_NAME=eims-ocr-manifests
EIMS_MINIO_SECURE=false
