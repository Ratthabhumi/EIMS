{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EIMS annotation semantics v2 (parallel DEV-only proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_manifest",
    "source_manifest_sha256",
    "scope",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "source_manifest": {
      "const": "manifest.v1.json"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "const": "DEV_ONLY_PROPOSED"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "base_annotation_sha256",
          "review_status",
          "annotator_id",
          "truth"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "base_annotation_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "review_status": {
            "enum": [
              "DRAFT",
              "REVIEWED"
            ]
          },
          "annotator_id": {
            "type": "string"
          },
          "reviewer_id": {
            "type": "string"
          },
          "reviewed_annotation_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "truth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_family",
              "event_identity",
              "failure_present",
              "failure_type",
              "first_observed_failure",
              "last_observed_failure",
              "explicit_terminal_outcome",
              "root_cause_status",
              "supported_claims",
              "evidence_references",
              "uncertainty_reason"
            ],
            "properties": {
              "source_family": {
                "enum": [
                  "windows_event",
                  "veeam_vbr",
                  "vmware",
                  "fortinet",
                  "cisco_asa",
                  "linux_syslog",
                  "json",
                  "unknown_text"
                ]
              },
              "event_identity": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "failure_present": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "failure_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "first_observed_failure": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "file",
                      "line"
                    ],
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "end_line": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "last_observed_failure": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "file",
                      "line"
                    ],
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "end_line": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "explicit_terminal_outcome": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "evidence"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "FAILED",
                          "SUCCEEDED",
                          "WARNING"
                        ]
                      },
                      "evidence": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "file",
                            "line"
                          ],
                          "properties": {
                            "file": {
                              "type": "string",
                              "minLength": 1
                            },
                            "line": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "end_line": {
                              "type": "integer",
                              "minimum": 1
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "root_cause_status": {
                "enum": [
                  "UNKNOWN",
                  "HYPOTHESIZED",
                  "PROVEN"
                ]
              },
              "supported_claims": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence_references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "file",
                    "line",
                    "evidence_type"
                  ],
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "evidence_type": {
                      "enum": [
                        "EVENT_IDENTITY",
                        "SEVERITY",
                        "FAILURE_DESCRIPTION",
                        "TECHNICAL_FAILURE",
                        "EXPLICIT_OUTCOME",
                        "ROOT_CAUSE",
                        "INFORMATIONAL"
                      ]
                    }
                  }
                }
              },
              "uncertainty_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
