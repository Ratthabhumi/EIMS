{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EIMS Analyzer Gold Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "FROZEN",
        "EVALUATED"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "line_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "claim": {
          "type": "string"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\./)[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_family": {
          "type": "string"
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a",
        "b",
        "related"
      ],
      "properties": {
        "a": {
          "type": "string",
          "minLength": 1
        },
        "b": {
          "type": "string",
          "minLength": 1
        },
        "related": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "split",
        "origin",
        "review_status",
        "files",
        "truth"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "split": {
          "enum": [
            "dev",
            "heldout"
          ]
        },
        "origin": {
          "enum": [
            "synthetic",
            "authorized_sanitized_field"
          ]
        },
        "scenario_group": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "enum": [
            "DRAFT",
            "REVIEWED"
          ]
        },
        "annotator_id": {
          "type": "string"
        },
        "reviewer_id": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "truth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_family",
            "diagnostic_code",
            "abstain_expected",
            "evidence",
            "correlation_pairs",
            "applicable_kb"
          ],
          "properties": {
            "source_family": {
              "enum": [
                "windows_event",
                "veeam_vbr",
                "vmware",
                "fortinet",
                "cisco_asa",
                "linux_syslog",
                "json",
                "unknown_text"
              ]
            },
            "diagnostic_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "abstain_expected": {
              "type": "boolean"
            },
            "first_failure": {
              "anyOf": [
                {
                  "$ref": "#/$defs/line_ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "terminal_failure": {
              "anyOf": [
                {
                  "$ref": "#/$defs/line_ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/line_ref"
              }
            },
            "correlation_pairs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/pair"
              }
            },
            "applicable_kb": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
