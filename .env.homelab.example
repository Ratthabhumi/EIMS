# ==============================================================================
# EIMS Homelab Production Deployment Configuration Template
# Governed by EIMS Documentation System (EDS v1.0.0)
# Copy this file to .env.homelab and supply strong production secrets.
# NEVER COMMIT .env.homelab OR REAL PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# System Runtime Mode
EIMS_ENVIRONMENT=production
EIMS_LOG_LEVEL=INFO
EIMS_AUTH_MODE=secure

# PostgreSQL 16 Persistence (Direct Port 5432)
EIMS_DB_USER=eims_user
EIMS_DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD_32CHARS
EIMS_DB_HOST=127.0.0.1
EIMS_DB_PORT=5432
EIMS_DB_NAME=eims_registry
EIMS_DB_POOL_SIZE=20
EIMS_DB_MAX_OVERFLOW=10

# Redis 7 In-Memory Cache & Stream Broker
EIMS_REDIS_HOST=127.0.0.1
EIMS_REDIS_PORT=6379
EIMS_REDIS_DB_INDEX=0

# Security & Cryptographic Auth Contracts (Core Law 5)
# JWT_SECRET_KEY: Generate via `openssl rand -hex 32` or python `secrets.token_hex(32)`
EIMS_JWT_SECRET_KEY=REPLACE_WITH_GENERATED_JWT_SECRET_HEX_64CHARS
EIMS_JWT_ALGORITHM=HS256
EIMS_ACCESS_TOKEN_EXPIRES_MINUTES=60
EIMS_ADMIN_TOKEN=REPLACE_WITH_STRONG_ADMIN_BEARER_TOKEN_32CHARS
EIMS_ADMIN_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_ACCOUNT_PASSWORD

# MinIO S3 Object Storage Gateway (Private Bucket)
EIMS_MINIO_ENDPOINT=127.0.0.1:9000
EIMS_MINIO_ACCESS_KEY=eims_minio_admin
EIMS_MINIO_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_ROOT_PASSWORD_32CHARS
EIMS_MINIO_BUCKET_NAME=eims-ocr-manifests
EIMS_MINIO_SECURE=false

# Grafana Admin Credentials
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD

# Operational Dashboard Ingress & CORS Configuration
# Set to your Homelab hostname or LAN IP (e.g. http://192.168.1.100:3001 or https://eims.lab.local)
NEXT_PUBLIC_EIMS_API_URL=http://localhost:8000
EIMS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
